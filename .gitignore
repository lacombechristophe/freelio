# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/src/generated/prisma-postgres
/prisma/postgresql/schema.prisma

# SQLite dev database — contains local data, never commit
*.db
*.db-journal
*.db-wal
*.db-shm

# Build logs
build_log.txt

# Scratch / planning docs (use docs/ or a wiki instead)
/scratch/

# Local-first runtime data: attachments, automatic backups and staged imports
/data/
/test-results/
/playwright-report/
/tmp/
