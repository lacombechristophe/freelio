# ══════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════
# SQLite (dev) — set DATABASE_URL in .env
DATABASE_URL="file:./dev.db"
# PostgreSQL (prod) — uncomment and replace:
# DATABASE_URL="postgresql://user:password@host:5432/freelio"

# ══════════════════════════════════════════════════════════
# NEXTAUTH / AUTH
# ══════════════════════════════════════════════════════════
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
AUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ══════════════════════════════════════════════════════════
# ENCRYPTION (IBAN storage — AES-256-GCM)
# ══════════════════════════════════════════════════════════
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# ══════════════════════════════════════════════════════════
# JWT (Guest portal links for quotes/invoices)
# ══════════════════════════════════════════════════════════
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here"

# ══════════════════════════════════════════════════════════
# EMAIL (Resend)
# ══════════════════════════════════════════════════════════
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ══════════════════════════════════════════════════════════
# AI (Google Gemini)
# ══════════════════════════════════════════════════════════
GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ══════════════════════════════════════════════════════════
# QUEUES (Redis / BullMQ — for PDF generation & emails)
# ══════════════════════════════════════════════════════════
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ══════════════════════════════════════════════════════════
# RATE LIMITING (Upstash Redis)
# ══════════════════════════════════════════════════════════
UPSTASH_REDIS_REST_URL="https://xxxxxxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ══════════════════════════════════════════════════════════
# FILE STORAGE (UploadThing)
# ══════════════════════════════════════════════════════════
UPLOADTHING_SECRET="sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
UPLOADTHING_APP_ID="xxxxxxxxxxxxxxxx"

# ══════════════════════════════════════════════════════════
# FILE STORAGE (Cloudflare R2 — for PDF archiving)
# ══════════════════════════════════════════════════════════
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="freelio-archive"

# "r2" est recommandé et obligatoire par défaut en production.
# En développement, l'absence de configuration utilise data/migrations.
MIGRATION_STORAGE_DRIVER="r2"
