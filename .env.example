# Copiez ce fichier vers .env pour Prisma et le développement local.
# Ne placez jamais de secret réel dans ce fichier versionné.

# ── Base de données ───────────────────────────────────────
# Développement local (SQLite)
DATABASE_URL="file:./dev.db"
# Production : utilisez PostgreSQL avec TLS, par exemple :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crm?sslmode=require"

# ── URL publique et authentification Auth.js ─────────────
# Générez une valeur avec : openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"
# URL canonique HTTPS de l'application en production.
AUTH_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"
# Alias conservé pour les environnements NextAuth qui l'utilisent encore.
NEXTAUTH_URL="http://localhost:3000"

# ── Chiffrement applicatif et jetons publics ──────────────
# ENCRYPTION_KEY chiffre notamment l'IBAN et les identifiants de migration.
# Sa rotation nécessite un plan de rechiffrement.
ENCRYPTION_KEY="replace-with-an-independent-long-random-secret"
# JWT_SECRET signe les liens applicatifs qui reposent sur src/lib/jwt.ts.
JWT_SECRET="replace-with-an-independent-long-random-secret"
# Secret dédié aux liens publics de désinscription marketing (32 caractères minimum).
# Le code peut replier sur JWT_SECRET/AUTH_SECRET, mais une clé dédiée est recommandée en production.
CONSENT_TOKEN_SECRET="replace-with-an-independent-32-char-minimum-secret"

# ── E-mail transactionnel (Resend) ───────────────────────
# Facultatif en développement ; requis pour les liens magiques en production.
RESEND_API_KEY=""
EMAIL_FROM="Votre entreprise <noreply@votre-domaine.fr>"
SUPPORT_EMAIL=""

# ── Espace destinataire et capture des prospects ──────────
# Requis en production : ID Prisma exact de la société destinataire des leads.
PUBLIC_LEAD_COMPANY_ID=""
PUBLIC_PRIVACY_NOTICE_URL="https://votre-domaine.fr/politique-de-confidentialite/"
# Liste séparée par des virgules, sans slash final.
LEAD_ALLOWED_ORIGINS="https://votre-domaine.fr,https://www.votre-domaine.fr"
# Secret alternatif pour une intégration serveur-à-serveur du formulaire.
LEAD_INGEST_SECRET="replace-with-an-independent-long-random-secret"
# Sel indépendant utilisé pour hacher IP, user-agent et empreintes de preuve.
LEAD_HASH_SALT="replace-with-an-independent-long-random-secret"

# ── Séquences e-mail et automatisations ───────────────────
# Secret Bearer de la route POST /api/automations/process pour un cron externe.
AUTOMATION_CRON_SECRET="replace-with-an-independent-long-random-secret"

# ── Rate limiting distribué (Upstash Redis) ──────────────
# Sans ces valeurs, le développement utilise une mémoire locale non partagée.
# Configurez-les en production, surtout avec plusieurs instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Files de travaux (Redis / BullMQ) ─────────────────────
# Requis si le worker de génération asynchrone est lancé.
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ── Stockage privé Cloudflare R2 ──────────────────────────
# Les deux drivers doivent valoir r2 en production. "local" est réservé au dev.
FILE_STORAGE_DRIVER="local"
MIGRATION_STORAGE_DRIVER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="crm-private"

# ── OCR de justificatifs (Google Gemini, facultatif) ──────
GEMINI_API_KEY=""

# ── Tests E2E uniquement ──────────────────────────────────
# Ne ciblez jamais la production avec Playwright.
E2E_USER_EMAIL="qa-crm@example.com"
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
