{
  "name": "crm-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:prepare:dev",
    "dev": "next dev",
    "prebuild": "npm run db:generate:production",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx src/worker.ts",
    "postinstall": "npm run db:generate",
    "db:generate": "node scripts/sync-prisma-schemas.mjs",
    "db:generate:production": "node scripts/sync-prisma-schemas.mjs --production",
    "db:prepare:dev": "npm run db:generate && node scripts/prepare-dev-database.mjs",
    "db:sync:local": "npm run db:prepare:dev",
    "db:bootstrap:sqlite": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script | prisma db execute --stdin --schema prisma/schema.prisma",
    "db:deploy:postgres": "node scripts/sync-prisma-schemas.mjs && prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:status:postgres": "node scripts/sync-prisma-schemas.mjs && prisma migrate status --schema prisma/postgresql/schema.prisma",
    "db:backfill-memberships": "tsx prisma/backfill-memberships.ts",
    "security:encrypt-sensitive": "tsx scripts/encrypt-sensitive-fields.ts",
    "backup:decrypt": "tsx scripts/decrypt-logical-backup.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "npm run db:generate && vitest run --coverage",
    "verify": "npm run db:prepare:dev && npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@attestwire/en16931": "^0.7.3",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@base-ui/react": "^1.3.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "^16.3.3",
    "@prisma/client": "6.12.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "bullmq": "^5.73.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "6.12.0",
    "puppeteer": "^25.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.72.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "read-excel-file": "^9.3.10",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.2.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
