{
  "name": "crm-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "npm run db:prepare:dev",
    "dev": "next dev",
    "demo": "node scripts/demo.mjs",
    "demo:backup": "node scripts/backup-demo.mjs",
    "prebuild": "npm run db:generate:production",
    "build": "node --max-old-space-size=4096 --import ./scripts/build-memory.mjs node_modules/next/dist/bin/next build --webpack",
    "start": "node --import tsx scripts/start-server.mjs",
    "lint": "eslint . && oxlint .",
    "worker": "node --conditions=react-server --import tsx scripts/start-worker.mjs",
    "postinstall": "npm run db:generate",
    "db:generate": "node scripts/sync-prisma-schemas.mjs",
    "db:generate:production": "node scripts/sync-prisma-schemas.mjs --production",
    "db:prepare:dev": "npm run db:generate && node scripts/prepare-dev-database.mjs",
    "db:sync:local": "npm run db:prepare:dev",
    "db:bootstrap:sqlite": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script | prisma db execute --stdin",
    "db:deploy:postgres": "node scripts/sync-prisma-schemas.mjs && prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:status:postgres": "node scripts/sync-prisma-schemas.mjs && prisma migrate status --schema prisma/postgresql/schema.prisma",
    "db:backfill-memberships": "tsx prisma/backfill-memberships.ts",
    "security:encrypt-sensitive": "tsx scripts/encrypt-sensitive-fields.ts",
    "backup:decrypt": "tsx scripts/decrypt-logical-backup.ts",
    "typecheck": "next typegen && node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --no-file-parallelism",
    "test:coverage": "npm run db:generate && vitest run --coverage --no-file-parallelism",
    "verify": "npm run db:prepare:dev && npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@attestwire/en16931": "^0.14.1",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "16.4.3",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/generator-helper": "7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@sparticuz/chromium": "152.0.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "bullmq": "^5.73.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "handlebars": "^4.7.10",
    "ioredis": "^5.10.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "puppeteer": "^25.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.91.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "read-excel-file": "^9.3.12",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint-community/eslint-utils": "4.10.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "oxlint": "1.89.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "8.5.26",
    "vite": "8.3.3"
  },
  "type": "module"
}
